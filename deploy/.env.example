# Copy to .env and fill in. Keep .env private — it holds passwords.

# Address people will open, without https:// (e.g. procurement.tubecafecambodia.com)
DOMAIN=procurement.tubecafecambodia.com
# Leave empty on a VPS with a public domain (automatic Let's Encrypt certificate).
# Set to "tls internal" on a company-network server with no public domain.
TLS_MODE=

# Generate with: openssl rand -hex 24   /   openssl rand -hex 32
DB_PASSWORD=
COOKIE_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI: https://<DOMAIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=tubecafecambodia.com

# First administrator — must be a Google Workspace account in the allowed domain.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Heang Senghong
