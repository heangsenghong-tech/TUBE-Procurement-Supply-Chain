{
  "name": "tube-procurement",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @tube/api dev",
    "dev:web": "pnpm --filter @tube/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @tube/api test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @tube/api db:generate",
    "db:migrate": "pnpm --filter @tube/api db:migrate",
    "db:seed": "pnpm --filter @tube/api db:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
